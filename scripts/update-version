#!/bin/bash

# Updates Heimer version in all build and packaging scripts and sets the
# release date in CHANGELOG.
# Must be run in the project root.

VERSION_MAJOR=$1
VERSION_MINOR=$2
VERSION_PATCH=$3

if [[ ! $1 || ! $2 || ! $3 ]]; then
    echo "Usage: $0 VERSION_MAJOR VERSION_MINOR VERSION_PATCH"
    exit 1
fi

# Check everything before modifying any files
CHANGELOG="CHANGELOG"
# Checked, because an empty date would otherwise be substituted silently
RFC_DATE=$(./scripts/rfc2822Time) || exit 1
if [[ -z $RFC_DATE ]]; then
    echo "Error: ./scripts/rfc2822Time produced no date."
    exit 1
fi
if ! grep -q "^x\.y\.z$" ${CHANGELOG}; then
    echo "Error: No x.y.z section in ${CHANGELOG}."
    exit 1
fi

FILE=CMakeLists.txt
echo "Updating ${FILE} .."
sed -i "s/^set(APPLICATION_VERSION_MAJOR.*/set(APPLICATION_VERSION_MAJOR ${VERSION_MAJOR})/" ${FILE} || exit 1
sed -i "s/^set(APPLICATION_VERSION_MINOR.*/set(APPLICATION_VERSION_MINOR ${VERSION_MINOR})/" ${FILE} || exit 1
sed -i "s/^set(APPLICATION_VERSION_PATCH.*/set(APPLICATION_VERSION_PATCH ${VERSION_PATCH})/" ${FILE} || exit 1

for FILE in snapcraft.yaml scripts/build-app-image scripts/build-archive scripts/build-windows-zip; do
    echo "Updating ${FILE} .."
    sed -i -E "s/[0-9]+\.[0-9]+\.[0-9]+/$VERSION_MAJOR.$VERSION_MINOR.$VERSION_PATCH/g" ${FILE} || exit 1
done

echo "Updating ${CHANGELOG} .."
VERSION="${VERSION_MAJOR}.${VERSION_MINOR}.${VERSION_PATCH}"
UNDERLINE=$(printf "%${#VERSION}s" | tr " " "=")

# Replace the first x.y.z with the version and adjust the underline to its length
sed -i "0,/^x\.y\.z$/{s/^x\.y\.z$/${VERSION}/;n;s/^=\+$/${UNDERLINE}/}" ${CHANGELOG} || exit 1

# Add the date after the first "Release date:"
sed -i "0,/^Release date:$/s/^Release date:$/Release date:\n\n${RFC_DATE}/" ${CHANGELOG} || exit 1

# Prepend a new template for the next release
printf "x.y.z\n=====\n\nRelease date:\n\nNew features:\n\nBug fixes:\n\nOther:\n\n" > ${CHANGELOG}.new || exit 1
cat ${CHANGELOG} >> ${CHANGELOG}.new && mv ${CHANGELOG}.new ${CHANGELOG} || exit 1

git diff

echo "Done."

